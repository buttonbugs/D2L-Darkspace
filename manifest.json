{
    "manifest_version": 3,
    "name": "D2L Darkspace",
    "version": "1.0.2",
    "icons": {
        "128": "dark_mode.png"
    },
    "content_scripts": [{
        "matches":["https://*/d2l/*"],
        "css": ["darkspace.css"],
        "run_at": "document_start"
    }],
    "host_permissions": ["<all_urls>"],
    "permissions": ["activeTab"]
}